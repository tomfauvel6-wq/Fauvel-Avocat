# Variables d'environnement requises pour le formulaire de contact.
#
# 1) Créer un compte sur https://resend.com et générer une clé API.
# 2) Vérifier le domaine chez Resend (enregistrements DNS chez le registrar),
#    faute de quoi les emails seront rejetés ou classés en spam.
# 3) Copier ce fichier en .env.local (développement) et créer les mêmes variables
#    dans Vercel (Settings > Environment Variables) pour la production.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Adresse qui reçoit les demandes du formulaire
CONTACT_TO_EMAIL=tom.fauvel@fauvel-avocat.fr

# Adresse d'expédition : doit appartenir à un domaine vérifié chez Resend
CONTACT_FROM_EMAIL=site@fauvel-avocat.fr

# URL publique du site (à ajuster au domaine définitif)
NEXT_PUBLIC_SITE_URL=https://fauvel-avocat.fr
